set bgColor white
lighting soft
graphics silhouettes true
windowsize 960 720
open monomer.cif id 1
hide #1 atoms
cartoon #1
color #1 lime
view #1 pad 0.25 clip false
save monomer.png width 960 height 720 supersample 2
movie record size 960,720 supersample 2
turn y 2 180 models #1
wait 180
movie encode monomer.mp4 framerate 30
close #1
open complex.cif id 1
hide #1 atoms
cartoon #1
color #1 teal
color #1/B lime
show #1/A:37|#1/A:38|#1/A:40|#1/A:42|#1/A:44|#1/A:51|#1/A:52|#1/A:53|#1/A:54|#1/A:98|#1/A:102|#1/A:104|#1/A:108|#1/A:109|#1/A:110|#1/A:112|#1/A:115|#1/B:43|#1/B:44|#1/B:45|#1/B:46|#1/B:47|#1/B:49|#1/B:50|#1/B:51|#1/B:52|#1/B:53|#1/B:54|#1/B:56|#1/B:57|#1/B:60|#1/B:61|#1/B:64 atoms
style #1/A:37|#1/A:38|#1/A:40|#1/A:42|#1/A:44|#1/A:51|#1/A:52|#1/A:53|#1/A:54|#1/A:98|#1/A:102|#1/A:104|#1/A:108|#1/A:109|#1/A:110|#1/A:112|#1/A:115|#1/B:43|#1/B:44|#1/B:45|#1/B:46|#1/B:47|#1/B:49|#1/B:50|#1/B:51|#1/B:52|#1/B:53|#1/B:54|#1/B:56|#1/B:57|#1/B:60|#1/B:61|#1/B:64 stick
view #1 pad 0.25 clip false
save complex.png width 960 height 720 supersample 2
hide #1 models
open pose-target.cif id 2
open pose-binder.cif id 3
hide #2 atoms
cartoon #2
color #2 teal
hide #3 atoms
cartoon #3
color #3 lime
hide #2,3 models
open monomer.cif id 4
hide #4 atoms
cartoon #4
color #4 lime
view #4 pad 0.25 clip false
movie record size 960,720 supersample 2
turn y 2 180 models #4
wait 180
hide #4 models
show #2,3 models
move x 35 models #3
view #2,3 pad 0.25 clip false
wait 30
move x -0.5 70 models #3
wait 70
hide #2,3 models
show #1 models
view #1 pad 0.25 clip false
wait 20
turn y 2 180 models #1
wait 180
wait 30
movie encode complex.mp4 framerate 30
